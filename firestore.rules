rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health check document used on app boot
    match /test/connection {
      allow get: if true;
    }

    // Campaigns collection synced across browsers and mobile PWA
    match /autoviral_campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if true;
      allow create, update: if isValidId(campaignId)
        && request.resource.data.id is string
        && (
          (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 500) ||
          (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 500)
        );
      allow delete: if isValidId(campaignId);
    }

    // Landing page settings, workspace sync, and cross-browser metadata
    match /autoviral_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Public analytics and tracking events (views, clicks, conversions)
    match /autoviral_tracking_events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create: if isValidId(eventId)
        && request.resource.data.campaignId is string;
      allow update, delete: if isValidId(eventId);
    }

    // Mined Instagram / social profiles
    match /autoviral_profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      allow create, update, delete: if isValidId(profileId)
        && request.resource.data.handle is string;
    }

    // Customers and leads with WhatsApp and purchase details
    match /autoviral_customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if true;
      allow create, update, delete: if isValidId(customerId)
        && request.resource.data.name is string;
    }
  }
}
