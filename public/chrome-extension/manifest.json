{
  "manifest_version": 3,
  "name": "AutoViral AI - Mapeador FB, Instagram, YouTube & Pinterest",
  "version": "1.3.3",
  "description": "Mapeia grupos do Facebook e contas do Instagram sem limite, sincroniza conta conectada para Stories Próprio e integra FB, YouTube e Pinterest ao AutoViral AI.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoViral AI - FB, Insta, YT & Pin"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.pinterest.com/*",
    "*://*.instagram.com/*",
    "*://*.kiwify.com.br/*",
    "*://localhost/*",
    "*://*.vercel.app/*",
    "*://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.youtube.com/*",
        "*://*.pinterest.com/*",
        "*://*.instagram.com/*",
        "*://*.run.app/*",
        "*://*.vercel.app/*",
        "*://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
