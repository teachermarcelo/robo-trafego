{
  "manifest_version": 3,
  "name": "AutoViral AI - Mapeador FB, YouTube & Robô Pinterest",
  "version": "1.2.0",
  "description": "Mapeia automaticamente grupos do Facebook por rolagem, sincroniza públicos qualificados, automatiza postagens humanizadas (300s a 400s), engaja no YouTube e automatiza Pins virais no Pinterest.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoViral AI - FB, YouTube & Pinterest"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.pinterest.com/*",
    "*://*.instagram.com/*",
    "*://*.kiwify.com.br/*",
    "*://localhost/*",
    "*://*.vercel.app/*",
    "*://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.youtube.com/*",
        "*://*.pinterest.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
